{
  "name": "agent-diff-review",
  "displayName": "Agent Diff Review",
  "description": "Review branch and worktree diffs, leave line comments, and send feedback to your existing coding agent session.",
  "version": "0.2.1",
  "publisher": "local-agent-tools",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.94.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "agentDiffReviewContainer", "title": "Agent Diff Review", "icon": "resources/review.svg" }] },
    "views": { "agentDiffReviewContainer": [
      { "id": "agentDiffReview.comparison", "name": "Comparison", "type": "webview", "icon": "resources/review.svg", "contextualTitle": "Agent Diff Review", "initialSize": 45 },
      { "id": "agentDiffReview", "name": "Changes", "icon": "resources/review.svg", "contextualTitle": "Agent Diff Review", "initialSize": 30 },
      { "id": "agentDiffReview.comments", "name": "Comments", "icon": "resources/review.svg", "contextualTitle": "Agent Diff Review", "initialSize": 25 }
    ] },
    "viewsWelcome": [
      { "view": "agentDiffReview", "contents": "Choose the left and right sides in Comparison, then compare their changes.\n[Select Comparison](command:agentDiffReview.compare)" },
      { "view": "agentDiffReview.comments", "contents": "Add comments to lines in a diff. All comments and agent replies stay here across comparison refreshes.\n[Select Comparison](command:agentDiffReview.compare)" }
    ],
    "commands": [
      { "command": "agentDiffReview.compare", "title": "Select Comparison", "category": "Agent Diff Review", "icon": "$(git-compare)" },
      { "command": "agentDiffReview.refresh", "title": "Refresh Comparison", "category": "Agent Diff Review", "icon": "$(refresh)" },
      { "command": "agentDiffReview.fetch", "title": "Fetch Remote Branches", "category": "Agent Diff Review", "icon": "$(cloud-download)" },
      { "command": "agentDiffReview.connect", "title": "Connect Agent", "category": "Agent Diff Review", "icon": "$(plug)" },
      { "command": "agentDiffReview.selectAgent", "title": "Select Agent Session", "category": "Agent Diff Review", "icon": "$(plug)" },
      { "command": "agentDiffReview.send", "title": "Send Review", "category": "Agent Diff Review", "icon": "$(send)", "enablement": "agentDiffReview.hasDrafts" },
      { "command": "agentDiffReview.addComment", "title": "Comment on Selected Lines", "category": "Agent Diff Review", "enablement": "resourceScheme == agent-review" },
      { "command": "agentDiffReview.showComments", "title": "Show Review Comments", "category": "Agent Diff Review", "icon": "$(comment-discussion)" },
      { "command": "agentDiffReview.findComment", "title": "Find Review Comment", "category": "Agent Diff Review", "icon": "$(search)" },
      { "command": "agentDiffReview.openComment", "title": "Go to Comment" },
      { "command": "agentDiffReview.reviewLatestComment", "title": "Review Latest Changes", "icon": "$(git-compare)" },
      { "command": "agentDiffReview.resolveComment", "title": "Mark as Resolved", "icon": "$(check)" },
      { "command": "agentDiffReview.reopenComment", "title": "Reopen Comment", "icon": "$(debug-restart)" },
      { "command": "agentDiffReview.markNeedsChanges", "title": "Mark as Needs Changes", "icon": "$(warning)" },
      { "command": "agentDiffReview.clearNeedsChanges", "title": "Clear Needs Changes", "icon": "$(circle-slash)" },
      { "command": "agentDiffReview.sendCommentReview", "title": "Send Drafts from This Snapshot", "icon": "$(send)" },
      { "command": "agentDiffReview.openDiff", "title": "Open Diff" },
      { "command": "agentDiffReview.showReview", "title": "Open Review Snapshot" },
      { "command": "agentDiffReview.postComment", "title": "Add Comment", "enablement": "!commentIsEmpty" },
      { "command": "agentDiffReview.deleteComment", "title": "Delete Draft", "icon": "$(trash)" },
      { "command": "agentDiffReview.resolveThread", "title": "Resolve / Reopen", "icon": "$(check)" }
    ],
    "menus": {
      "view/title": [
        { "command": "agentDiffReview.compare", "when": "view == agentDiffReview && !agentDiffReview.hasReview", "group": "navigation@1" },
        { "command": "agentDiffReview.refresh", "when": "view == agentDiffReview && agentDiffReview.hasReview", "group": "navigation@2" },
        { "command": "agentDiffReview.showComments", "when": "view == agentDiffReview", "group": "navigation@3" },
        { "command": "agentDiffReview.findComment", "when": "view == agentDiffReview.comments", "group": "navigation@1" },
        { "command": "agentDiffReview.send", "when": "view == agentDiffReview.comments", "group": "navigation@2" },
        { "command": "agentDiffReview.selectAgent", "when": "view == agentDiffReview || view == agentDiffReview.comparison || view == agentDiffReview.comments", "group": "1_session@1" },
        { "command": "agentDiffReview.fetch", "when": "view == agentDiffReview || view == agentDiffReview.comparison", "group": "2_git" },
        { "command": "agentDiffReview.connect", "when": "view == agentDiffReview || view == agentDiffReview.comparison || view == agentDiffReview.comments", "group": "1_session@2" }
      ],
      "view/item/context": [
        { "command": "agentDiffReview.resolveComment", "when": "view == agentDiffReview.comments && viewItem =~ /ReviewComment$/ && viewItem != resolvedReviewComment", "group": "inline@1" },
        { "command": "agentDiffReview.reopenComment", "when": "view == agentDiffReview.comments && viewItem == resolvedReviewComment", "group": "inline@1" },
        { "command": "agentDiffReview.reviewLatestComment", "when": "view == agentDiffReview.comments && viewItem =~ /ReviewComment$/", "group": "inline@2" },
        { "command": "agentDiffReview.markNeedsChanges", "when": "view == agentDiffReview.comments && viewItem == openReviewComment", "group": "1_status@1" },
        { "command": "agentDiffReview.clearNeedsChanges", "when": "view == agentDiffReview.comments && viewItem == needsChangesReviewComment", "group": "1_status@1" },
        { "command": "agentDiffReview.sendCommentReview", "when": "view == agentDiffReview.comments && viewItem == draftReviewComment", "group": "2_send" }
      ],
      "editor/context": [{ "command": "agentDiffReview.addComment", "when": "resourceScheme == agent-review", "group": "review" }],
      "comments/commentThread/context": [{ "command": "agentDiffReview.postComment", "when": "commentController == agent-diff-review", "group": "inline" }],
      "comments/commentThread/title": [{ "command": "agentDiffReview.resolveThread", "when": "commentController == agent-diff-review && !commentThreadIsEmpty", "group": "navigation" }],
      "comments/comment/title": [{ "command": "agentDiffReview.deleteComment", "when": "commentController == agent-diff-review && comment == draft", "group": "navigation" }],
      "commandPalette": [
        { "command": "agentDiffReview.openComment", "when": "false" },
        { "command": "agentDiffReview.reviewLatestComment", "when": "false" },
        { "command": "agentDiffReview.resolveComment", "when": "false" },
        { "command": "agentDiffReview.reopenComment", "when": "false" },
        { "command": "agentDiffReview.markNeedsChanges", "when": "false" },
        { "command": "agentDiffReview.clearNeedsChanges", "when": "false" },
        { "command": "agentDiffReview.sendCommentReview", "when": "false" },
        { "command": "agentDiffReview.openDiff", "when": "false" },
        { "command": "agentDiffReview.showReview", "when": "false" },
        { "command": "agentDiffReview.postComment", "when": "false" },
        { "command": "agentDiffReview.deleteComment", "when": "false" },
        { "command": "agentDiffReview.resolveThread", "when": "false" }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:extension": "npm run compile && node scripts/test-extension.cjs",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.94.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
